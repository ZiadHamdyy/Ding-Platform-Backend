# Server Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/ding_db"

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/password
# OR use separate variables:
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@ding.com
SMTP_FROM_NAME=Ding Platform

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379
# OR for Redis Cloud/production:
# REDIS_URL=redis://username:password@host:port

# File Upload Configuration
UPLOAD_DIR=./uploads

# Sentry (Optional - for error tracking)
SENTRY_DNS=

# Server Name
SERVER_NAME=Ding-Platform-Backend

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Token Configuration
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
OTP_EXPIRES_IN_MINUTES=10

# API Configuration
API_PREFIX=api
API_DOCS_PATH=api/docs

# Security Configuration
BCRYPT_ROUNDS=10

# Frontend URLs (comma-separated for multiple origins)
FRONTEND_URLS=http://localhost:5173,https://ding-gray.vercel.app

# Session Configuration
SESSION_SECRET=your-session-secret-key-change-this-in-production

# Vercel Configuration (for serverless deployment)
# VERCEL=1